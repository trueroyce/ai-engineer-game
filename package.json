{
  "name": "ai-engineer-game",
  "version": "2.0.0",
  "private": true,
  "description": "一款包含三個案件、跨案職涯與本機唯讀 MCP 賽後教練的 AI 工程接案瀏覽器遊戲。",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/narrative/*.test.js tests/mcp/*.test.js tests/career/*.test.js tests/case-02/*.test.js tests/case-03/*.test.js",
    "test:narrative": "node --test tests/narrative/*.test.js",
    "test:mcp": "node --test tests/mcp/*.test.js tests/narrative/run-export.test.js",
    "test:browser": "node tests/browser/deepening.browser.mjs --browser chrome",
    "test:browser:career": "node tests/browser/career.browser.mjs --browser chrome",
    "test:browser:case-02": "node tests/browser/case-02.browser.mjs --browser chrome",
    "test:browser:case-03": "node tests/browser/case-03.browser.mjs --browser chrome",
    "test:browser:visual": "node tests/browser/visual-redesign.browser.mjs --browser chrome",
    "test:local-coach": "node --test tests/local-coach/*.test.js",
    "test:browser:mcp": "node tests/browser/mcp-export.browser.mjs --browser chrome",
    "test:browser:local-coach": "node tests/browser/local-coach.browser.mjs --browser chrome"
  }
}
